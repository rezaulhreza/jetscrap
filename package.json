{
  "name": "jetscrap",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "wrangler dev --port 8787",
    "build": "tsc --noEmit && vite build",
    "preview": "vite build && wrangler dev --port 8787",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "tsc --noEmit && vite build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/saira": "^5.3.0",
    "@fontsource/saira-condensed": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
